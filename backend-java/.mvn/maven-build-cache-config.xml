<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Maven Build Cache Configuration
  ===============================
  This keeps a local cache of build outputs so repeat builds can restore
  previously generated results instead of recompiling identical inputs.

  Reference: https://maven.apache.org/extensions/maven-build-cache-extension/
-->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0
                           https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">

    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <local>
            <maxBuildsCached>5</maxBuildsCached>
        </local>
        <remote enabled="false"/>
    </configuration>

    <input>
        <global>
            <glob>{*.java,*.xml,*.properties,*.yaml,*.yml}</glob>
        </global>
    </input>

    <executionControl>
        <runAlways>
            <goalsLists>
                <goalsList>
                    <goals>
                        <goal>test</goal>
                        <goal>repackage</goal>
                    </goals>
                </goalsList>
            </goalsLists>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </runAlways>
    </executionControl>
</cache>
